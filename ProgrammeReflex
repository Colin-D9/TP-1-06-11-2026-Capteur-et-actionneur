#include <stdio.h>
#include <stdlib.h>
#include <pigpiod_if2.h>
#include <time.h>

#define LED_ROUGE 5
#define LED_JAUNE 12
#define LED_VERTE 19

#define BOUTON_A 20
#define BOUTON_B 21

int main(void)
{
    int pi = pigpio_start(NULL, NULL);

    if (pi < 0)
    {
        printf("Impossible de se connecter a pigpiod\n");
        exit(1);
    }

    // Configuration des LEDs
    set_mode(pi, LED_ROUGE, PI_OUTPUT);
    set_mode(pi, LED_JAUNE, PI_OUTPUT);
    set_mode(pi, LED_VERTE, PI_OUTPUT);

    // Configuration des boutons
    set_mode(pi, BOUTON_A, PI_INPUT);
    set_mode(pi, BOUTON_B, PI_INPUT);

    set_pull_up_down(pi, BOUTON_A, PI_PUD_UP);
    set_pull_up_down(pi, BOUTON_B, PI_PUD_UP);

    // Initialisation du hasard
    srand(time(NULL));

    // LEDs eteintes au depart
    gpio_write(pi, LED_ROUGE, PI_LOW);
    gpio_write(pi, LED_JAUNE, PI_LOW);
    gpio_write(pi, LED_VERTE, PI_LOW);

    printf("Jeu de reflexes !\n");
    printf("Attendez que la LED jaune s'eteigne !\n");

    // Allumer la LED jaune
    gpio_write(pi, LED_JAUNE, PI_HIGH);

    // Attendre entre 2 et 5 secondes
    time_sleep(2 + (rand() % 3000) / 1000.0);

    // Eteindre la LED jaune
    gpio_write(pi, LED_JAUNE, PI_LOW);

    printf("GO !\n");

    int gagnant = 0;

    // Attendre le premier joueur
    while (gagnant == 0)
    {
        if (gpio_read(pi, BOUTON_A) == PI_LOW)
        {
            gagnant = 1;
        }
        else if (gpio_read(pi, BOUTON_B) == PI_LOW)
        {
            gagnant = 2;
        }

        time_sleep(0.01);
    }

    // Afficher le gagnant
    if (gagnant == 1)
    {
        printf("Joueur A gagne !\n");
        gpio_write(pi, LED_ROUGE, PI_HIGH);
    }
    else
    {
        printf("Joueur B gagne !\n");
        gpio_write(pi, LED_VERTE, PI_HIGH);
    }

    // Garder la LED allumee pendant 2 secondes
    time_sleep(2);

    // Eteindre les LEDs
    gpio_write(pi, LED_ROUGE, PI_LOW);
    gpio_write(pi, LED_VERTE, PI_LOW);

    pigpio_stop(pi);

    return 0;
}